DATABASE_URL=jdbc:postgresql://database-1.example.us-east-1.rds.amazonaws.com:5432/ccisj_database?sslmode=verify-full&sslrootcert=/opt/rds/global-bundle.pem
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-rotated-password
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGIN=http://localhost
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_MEMBER_EMAIL=socio@example.com
BOOTSTRAP_MEMBER_BPS=replace-with-bps-number
BOOTSTRAP_MEMBER_PASSWORD=replace-with-a-strong-password